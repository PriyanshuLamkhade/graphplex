# ==========================================
# Backend (.env in ./backend directory)
# ==========================================
TAVIL_API_KEY=your_tavily_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DATABASE_URL="postgresql://postgres:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@host:5432/postgres"
SUPABASE_API_SECRET=your_supabase_secret_key_here

# ==========================================
# Frontend (.env in ./frontend directory)
# ==========================================
BUN_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
BUN_PUBLIC_PUBLISHABLE_KEY=your_supabase_publishable_key_here
